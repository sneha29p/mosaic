# TerraSentry live-provider tuning. Demo Mode does not need provider access.
TERRASENTRY_HTTP_TIMEOUT=15
TERRASENTRY_JOB_MAX_SECONDS=180
TERRASENTRY_FAST_MODE=1
TERRASENTRY_SAR_WIDTH=320
TERRASENTRY_SAR_HEIGHT=320
TERRASENTRY_SAR_PROBE_SIZE=64
TERRASENTRY_MIN_VALID_OVERLAP=0.15
TERRASENTRY_TARGET_VALID_OVERLAP=0.55
TERRASENTRY_MAX_PAIR_PROBES=2
TERRASENTRY_MAX_SCENES=4
TERRASENTRY_MAX_STAC_RESULTS=30
# Optional explicit path. Default is ./demo/remal from the repository root.
# TERRASENTRY_DEMO_ROOT=C:\path\to\terrasentry\demo\remal
